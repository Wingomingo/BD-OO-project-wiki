<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.VersioneController">
    <Label text="Gestione Versioni" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <TableView fx:id="tableViewVersioni" prefWidth="600" prefHeight="300">
        <columns>
            <TableColumn fx:id="colIdVersione" text="ID Versione" prefWidth="80"/>
            <TableColumn fx:id="colTesto" text="Testo" prefWidth="180"/>
            <TableColumn fx:id="colNumero" text="Numero" prefWidth="80"/>
            <TableColumn fx:id="colData" text="Data" prefWidth="120"/>
            <TableColumn fx:id="colIdPagina" text="ID Pagina" prefWidth="80"/>
            <TableColumn fx:id="colIdAutore" text="ID Autore" prefWidth="80"/>
        </columns>
    </TableView>
</VBox>



