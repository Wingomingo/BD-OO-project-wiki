<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.MenuController">
    <top>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
            <Label fx:id="lblUserInfo" text="User Info"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
            <Button text="Gestione Utenti" onAction="#apriUtenti"/>
            <Button text="Gestione Pagine" onAction="#apriPagine"/>
            <Button text="Gestione Modifiche" onAction="#apriModifiche"/>
            <Button text="Gestione Versioni" onAction="#apriVersioni"/>
            <Button text="Gestione Notifiche" onAction="#apriNotifiche"/>
        </VBox>
    </center>
</BorderPane>




