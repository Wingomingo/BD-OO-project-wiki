<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.UtenteController"
      spacing="10" alignment="CENTER"
      style="-fx-padding: 20;">
    <Label text="Gestione Utenti" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TableView fx:id="tableViewUtenti" onMouseClicked="#selezionaUtente" prefWidth="700" prefHeight="300">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="150"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="150"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colPassword" text="Password" prefWidth="150"/>
            <TableColumn fx:id="colRuolo" text="Ruolo" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <TextField fx:id="txtNome" promptText="Nome"/>
        <TextField fx:id="txtUsername" promptText="Username"/>
    </HBox>
    <HBox spacing="10">
        <TextField fx:id="txtEmail" promptText="Email"/>
        <TextField fx:id="txtPassword" promptText="Password"/>
        <ComboBox fx:id="cmbRuolo" promptText="Ruolo"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Aggiorna" onAction="#aggiornaUtente" fx:id="btnAggiorna"/>
        <Button text="Elimina" onAction="#eliminaUtente" fx:id="btnElimina"/>
    </HBox>
    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
</VBox>





